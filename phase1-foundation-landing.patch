+        </button>
+      </div>
+
+      {open && (
+        <div className="border-t border-chrome-line px-4 pb-4 md:hidden">
+          <nav className="flex flex-col gap-1 pt-3">
+            {NAV_LINKS.map((link) => (
+              <a
+                key={link.href}
+                href={link.href}
+                onClick={() => setOpen(false)}
+                className="rounded-lg px-2 py-2 text-sm text-chrome-foreground/80 hover:bg-white/10"
+              >
+                {link.label}
+              </a>
+            ))}
